# Copy to .env.local for development, or enter securely in Vercel staging settings.
# Do not commit real credentials. NEXT_PUBLIC values are intentionally public.
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Test mode only. The implementation refuses live Stripe secret keys and live events.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GROUP=
STRIPE_PRICE_PRIVATE=
STRIPE_PRICE_GROUP_PACK=
STRIPE_PRICE_PRIVATE_PACK=
STRIPE_PRICE_LAB_MONTHLY=
STRIPE_PRICE_LAB_ANNUAL=

# Leave false for production. Use true only on the isolated, configured test deployment.
PLATFORM_BOOKING_ENABLED=false

# Notifications: Resend verified sender, plus an unpredictable cron bearer secret.
RESEND_API_KEY=
EMAIL_FROM=
CRON_SECRET=
# Optional destination for coach copies (no athlete names in notifications).
COACH_NOTIFICATION_EMAIL=

# Existing Vercel project access for read-only discovery and an authorized preview deployment.
# These are tooling requirements, not browser runtime variables.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
# Optional when the existing project belongs to a team.
VERCEL_TEAM_ID=

# Optional preview scheduling uses the existing CRON_SECRET above.
# Configure Supabase Vault names via docs/SCHEDULING.md, not public environment values.
# A protected preview may also require a Vercel automation bypass in Vault.

# Auth configuration tooling only; do not expose in the browser.
# See docs/AUTHENTICATION.md. SUPABASE_ACCESS_TOKEN is a Management API token.
SUPABASE_ACCESS_TOKEN=
AUTH_EMAIL_FROM=

# Release guard: set only AFTER hosted acceptance, legacy occupied-time reconciliation,
# and production reminder delivery pass for this exact Git commit. Not a test substitute.
BOOKING_CUTOVER_VERIFIED_COMMIT=
# Tooling-only existing live catalog read; never used for Checkout or enabled payments.
STRIPE_LIVE_READ_KEY=
